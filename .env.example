# Copy to your shell env to run on testmuAI Cloud.
# Leave the credentials unset to run LOCALLY (mobilecli).

# testmuAI Cloud credentials (LT_USERNAME / LT_ACCESS_KEY are also accepted):
TESTMU_USERNAME=your_username
TESTMU_ACCESS_KEY=your_access_key

# Optional app override — default is the public Proverbial artifact URL.
# Accepts an lt://APP… id, a local .apk/.ipa path, or your own url.
# TESTMU_APP=lt://APP_ID_OR_URL
# (or per-platform: LT_APP_ANDROID / LT_APP_IOS)

PLATFORM=android

# Local run only — path to a local Proverbial build (emulator .apk / simulator .app or .zip):
# LOCAL_APP_ANDROID=./apps/proverbial.apk
# LOCAL_APP_IOS=./apps/proverbial.zip
